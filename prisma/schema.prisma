generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum Provider {
  EMAIL
  GOOGLE
  FACEBOOK
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  GIFT_CARD
  MIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

/**
 * SHOP_WIDE = every current/future listing in the store; SPECIFIC_LISTINGS = only the linked PromotionProduct rows. Only meaningful for autoApply promotions — a buyer-entered coupon code always applies shop-wide by design (there's nothing to scope to a listing before the code is typed in).
 */
enum PromotionScope {
  SHOP_WIDE
  SPECIFIC_LISTINGS
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

// ── Product creation metadata (Image 13-14: "How It's Made" tab) ──────────────

enum WhoMadeIt {
  I_DID
  SHOP_MEMBER
  ANOTHER_COMPANY
}

enum HowItWasMade {
  MADE_TO_ORDER
  HANDMADE
  ASSEMBLED
  ALTERED
  CURATED_SET
  NATURAL_MATERIAL
}

enum RenewalType {
  AUTOMATIC
  MANUAL
}

enum ProcessingProfileType {
  MADE_TO_ORDER
  READY_TO_SHIP
}

// What a seller charges for one row of a delivery profile's standard
// delivery table (Etsy's "What you'll charge"). CALCULATED (weight/carrier
// API-based) is intentionally not modeled yet — out of scope for now.
enum ShippingChargeType {
  FIXED
  FREE
}

enum ReturnPolicy {
  NO_RETURNS
  RETURNS_ACCEPTED
  EXCHANGES_ONLY
}

enum DimensionUnit {
  CM
  IN
  MM
  M
}

enum ProductStatus {
  DRAFT // Being created — not yet published
  ACTIVE // Live and visible to buyers
  INACTIVE // Hidden from buyers, can be re-activated
  ARCHIVED // Soft-archived (replaces deletedAt pattern)
}

enum AffiliateStatus {
  PENDING // applied, waiting admin review
  ACTIVE // approved, can generate links
  SUSPENDED // temporarily disabled by admin
  REJECTED // application denied
}

enum CommissionStatus {
  PENDING // order placed, commission created
  CONFIRMED // 14 days after DELIVERED, locked
  APPROVED // admin approved for payout
  PAID // admin marked as paid
  CANCELLED // order refunded, commission voided
}

enum PayoutStatus {
  REQUESTED // affiliate submitted payout request
  PROCESSING // admin acknowledged
  PAID // transfer done, admin marked paid
  REJECTED // admin rejected (under threshold, fraud, etc.)
}

// ─── Multi-vendor enums ───────────────────────────────────────────────────────

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SellerLedgerEntryType {
  SALE
  TRANSACTION_FEE
  PAYMENT_PROCESSING_FEE
  REGULATORY_FEE
  LISTING_FEE
  ADJUSTMENT
  VAT
  DEPOSIT_FEE
  SHARE_SAVE_REFUND
  OFFSITE_ADS_FEE
}

enum LinkClickKind {
  SHARE_SAVE
  OFFSITE_AD
}

enum TargetedOfferTrigger {
  INTERESTED_SHOPPER
  THANK_YOU
  ABANDONED_BASKET
  FAVOURITED_ITEM
}

enum SocialPlatform {
  FACEBOOK
  PINTEREST
  X
}

enum SocialConnectionStatus {
  CONNECTED
  DISCONNECTED
}

enum BuyerOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  COUNTERED
}

enum OffersScope {
  ALL_LISTINGS
  SPECIFIC_LISTINGS
}

enum DepositSchedule {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum SellerPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum CategoryScope {
  PLATFORM
  STORE
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(dbgenerated("nanoid(12)"))
  email           String    @unique
  passwordHash    String?
  firstName       String?
  lastName        String?
  avatarUrl       String?
  phone           String?
  role            Role      @default(CUSTOMER)
  isEmailVerified Boolean   @default(false)
  provider        Provider  @default(EMAIL)
  providerId      String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cartEmailToken  String? @unique
  cartEmailOptOut Boolean @default(false)

  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  totpVerifiedAt DateTime?
  backupCodes    String[]

  // ── Seller fields ──────────────────────────────────────────────────────────
  isSeller    Boolean @default(false)
  storeId     String? // denormalized store id (set when approved); no FK to avoid circular ref
  permissions Json? // per-user granular permissions (ADMIN role only); null = use role defaults

  refreshTokens        RefreshToken[]
  authSessions         AuthSession[]
  sessionsRevokedAt    DateTime?
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  addresses            Address[]
  wishlistItems        WishlistItem[]
  cart                 Cart?
  orders               Order[]              @relation("UserOrders")
  customizationDrafts  CustomizationDraft[]
  reviews              Review[]
  notifications        Notification[]
  conversations        Conversation[]
  affiliateAccount     AffiliateAccount?
  ownedStore           Store?               @relation("StoreOwner")
  savedSearchTerms     SavedSearchTerm[]
  storeFollows         StoreFollow[]
  buyerOffers          BuyerOffer[]
  grantedSubscriptions StoreSubscription[]  @relation("GrantedSubscriptions")

  wishlistShareToken String? @unique
  wishlistIsPublic   Boolean @default(false)
  wishlistName       String? @db.VarChar(100)

  pushEnabled Boolean    @default(true)
  emailMessages Boolean @default(true)
  emailReviewReminders Boolean @default(true)
  emailOffers Boolean @default(false)
  fcmTokens   FcmToken[]

  adminNotes  String?   @db.Text
  adminTags   String[]
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  /// When this user's last socket disconnected, so "offline 5 minutes ago" can
  /// still be answered after an API restart — presence itself lives in Redis
  /// and is deliberately lost when the process dies. Written only on the
  /// transition to fully offline, not per socket, so a browser refresh (which
  /// disconnects and reconnects) does not write on every page load.
  lastSeenAt  DateTime?

  @@index([email])
}

model FcmToken {
  id        String   @id @default(dbgenerated("nanoid(12)"))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("web")
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("nanoid(12)"))
  tokenHash String    @unique
  sessionId String?
  session   AuthSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuthSession {
  id           String    @id @default(dbgenerated("nanoid(12)"))
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  location     String?
  refreshTokens RefreshToken[]

  @@index([userId, createdAt])
}

model EmailVerification {
  id        String    @id @default(dbgenerated("nanoid(12)"))
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(dbgenerated("nanoid(12)"))
  token     String    @unique
  email     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([userId])
}

// ─── User Profile ────────────────────────────────────────────────────────────

model Address {
  id           String   @id @default(dbgenerated("nanoid(12)"))
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String   @default("US")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(dbgenerated("nanoid(12)"))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Multi-vendor: Store & Plans ─────────────────────────────────────────────

model Store {
  id              String               @id @default(dbgenerated("nanoid(12)"))
  slug            String               @unique
  name            String
  description     String?              @db.Text
  logoUrl         String?
  bannerUrl       String?
  ownerId         String               @unique
  owner           User                 @relation("StoreOwner", fields: [ownerId], references: [id])
  status          StoreStatus          @default(PENDING)
  // ISO 3166-1 alpha-2 country code — used to determine regulatory operating
  // fee eligibility (see PlatformSettings.regulatoryFeeCountries). Nullable
  // for existing stores that predate this field; no fee applies until set.
  country         String?              @db.VarChar(2)
  adminNotes      String?              @db.Text
  rejectedReason  String?
  verifiedAt      DateTime?
  approvedById    String?
  fulfillmentMode StoreFulfillmentMode @default(AUTOMATIC)

  // ── Order processing schedule (Etsy: Delivery settings → Order processing
  // schedule) — Monday–Friday is always on and not configurable; a seller can
  // additionally opt Saturday and/or Sunday into their processing week so
  // dispatch-by-date estimates account for weekend prep. ──────────────────────
  processesOnSaturday Boolean @default(false)
  processesOnSunday   Boolean @default(false)

  // Shop-level switch for paid expedited-delivery upgrades (Etsy: Delivery
  // settings → Upgrades). Per-profile upgrade options (name/price/SLA) are
  // intentionally out of scope for now — this only gates whether the seller
  // has opted the feature on at all.
  deliveryUpgradesEnabled Boolean @default(false)

  // Denormalized stats
  totalProducts Int     @default(0)
  totalOrders   Int     @default(0)
  totalRevenue  Decimal @default(0) @db.Decimal(12, 2)
  rating        Decimal @default(0) @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moderationStatus ModerationStatus @default(PENDING)
  lastModeratedAt  DateTime?
  strikeCount      Int              @default(0)
  strikeRecords    StrikeRecord[]

  products           Product[]
  categories         Category[]
  storeOrders        StoreOrder[]
  progressSteps      OrderProgressStep[]
  ledgerEntries      SellerLedgerEntry[]
  payouts            SellerPayout[]
  shopSections       ShopSection[]
  shippingProfiles   ShippingProfile[]
  processingProfiles ProcessingProfile[]
  promotions         Promotion[]
  bundleOffers       BundleOffer[]
  reviews            Review[]            @relation("StoreReviews")
  conversations      Conversation[]
  conversationLabels ConversationLabel[]
  buyerNotes         BuyerNote[]
  autoReply          StoreAutoReply?
  messageSnippets    MessageSnippet[]

  // ── Performance Score (NFT-03) ────────────────────────────────────────────
  performanceScore      Int?
  scoreShipping         Int?
  scoreRefund           Int?
  scoreReview           Int?
  scoreResponse         Int?
  scoreBadge            String?
  scoreLastCalculatedAt DateTime?

  cartItems CartItem[] @relation("CartItemStore")

  fulfillmentConnections StoreFulfillmentConnection[]
  apiKeys                ApiKey[]

  followers StoreFollow[]

  // ── Finances (Etsy: Shop Manager → Finances) ──────────────────────────────
  currency           String             @default("USD") @db.VarChar(3)
  stripeCustomerId   String?
  autoBillingEnabled Boolean            @default(true)
  bankAccount        StoreBankAccount?
  billingCards       StoreBillingCard[]
  taxInfo            StoreTaxInfo?

  // ── Marketing: Share & Save / Offsite Ads (Etsy parity) ───────────────────
  shareSaveEnabled       Boolean                 @default(false)
  shareSaveJoinedAt      DateTime?
  offsiteAdsOptedOut     Boolean                 @default(false)
  linkClicks             StoreLinkClick[]
  targetedOfferCampaigns TargetedOfferCampaign[]

  // ── Marketing: Social media (UI-parity only — no real OAuth/posting) ─────
  socialConnections StoreSocialConnection[]
  socialPosts       SocialPost[]

  // ── Marketing: Let buyers make offers ─────────────────────────────────────
  offersEnabled            Boolean             @default(false)
  offersScope              OffersScope         @default(ALL_LISTINGS)
  /**
   * Null = "Receive all offers" (no floor on how low a buyer can offer).
   */
  offersMaxDiscountPercent Decimal?            @db.Decimal(5, 2)
  offerListings            StoreOfferListing[]
  buyerOffers              BuyerOffer[]

  // ── Shop Home editor (Etsy: Shop Manager → edit your storefront) ──────────
  // `description` already backs both the dashboard "Share your story" checklist
  // item AND this page's "About > your story" field — same concept, one column,
  // not duplicated here.
  tagline               String? // short line shown under the shop name, e.g. "Tis the season to shine by Ezihubb"
  location              String? // free-text display location, e.g. "Hai Phong, Vietnam" — not used for shipping/tax
  colorTheme            String? // hex or named theme token for the shop-home banner accent
  announcement          String?    @db.Text
  announcementUpdatedAt DateTime?
  aboutHeadline         String?
  aboutVideoUrl         String?
  aboutPhotoUrls        String[] // up to 5, enforced in the DTO
  ownerBio              String?    @db.Text // "Shop members" personal bio — this app has one owner per store, not a team roster
  featuredProductIds    String[] // up to 4 manually pinned listings for the "Featured area" grid — FREE, never gated by Plus
  // How the Featured area is laid out: 'grid' (standard, free) or 'mixed'
  // (one large photo + four smaller — Ezihubb Plus only). Nullable/absent is
  // treated as 'grid' everywhere; getStoreBySlug forces 'grid' for a store
  // without an active subscription, so a lapsed Plus store degrades to the
  // free layout without losing the stored preference.
  featuredLayout        String?
  socialLinks           Json? // { platform: string; url: string }[], up to 5, enforced in the DTO — null/absent means none set
  faqs                  StoreFaq[]

  // ── Ezihubb Plus (paid feature gate) ──────────────────────────────────────
  subscription StoreSubscription?

  @@index([slug])
  @@index([status])
  @@index([ownerId])
}

// ── Shop Home FAQ entries ─────────────────────────────────────────────────────

model StoreFaq {
  id        String   @id @default(dbgenerated("nanoid(12)"))
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([storeId])
}

// ── Ezihubb Plus (paid feature gate) ───────────────────────────────────────────
// Phase 1: SUPER_ADMIN grants/revokes by hand (paymentProvider = "MANUAL",
// externalSubscriptionId unused) — no card, no automatic billing, so PAST_DUE
// is unreachable this phase (kept in the enum so a later Stripe/VNPay webhook
// integration doesn't need a migration to add it).
//
// `status` alone is NEVER the source of truth for "does this store currently
// have Plus" — always combine with `currentPeriodEnd` via the shared
// `isEntitled()` helper (apps/api/src/modules/subscriptions/subscription-status.util.ts).
// There is no EXPIRED status value: a subscription whose currentPeriodEnd has
// passed is expired by definition, computed on read, never written — avoids a
// cron/lazy-update job and the drift risk of a second source of truth.
enum StoreSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED // SUPER_ADMIN revoked immediately — NOT used for a seller's own
  // "don't renew me" request, which keeps status ACTIVE and only
  // sets cancelAtPeriodEnd (access continues until currentPeriodEnd).
}

enum StoreSubscriptionCycle {
  MONTHLY
  ANNUAL
}

model StoreSubscription {
  id                 String                  @id @default(dbgenerated("nanoid(12)"))
  storeId            String                  @unique
  store              Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status             StoreSubscriptionStatus @default(ACTIVE)
  cycle              StoreSubscriptionCycle
  // Snapshot of PlatformSettings.plusMonthlyPrice/plusAnnualPrice AT GRANT TIME —
  // changing the live price later must never retroactively change what an
  // existing subscriber is already committed to.
  priceAtPurchase    Decimal                 @db.Decimal(10, 2)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean                 @default(false)
  cancelledAt        DateTime?

  // ── Payment-gateway integration point (unused in Phase 1) ──────────────────
  // A future Stripe/VNPay webhook calls the SAME service methods
  // (activate/markPastDue/cancel) this Phase's manual-grant endpoints call —
  // only these two fields plus `paymentProvider` change, schema stays as-is.
  paymentProvider        String? @default("MANUAL") // 'MANUAL' | 'STRIPE' | 'VNPAY' | ...
  externalSubscriptionId String?

  grantedByUserId String?
  grantedBy       User?   @relation("GrantedSubscriptions", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, currentPeriodEnd])
  @@index([grantedByUserId])
}

// ── Finances: seller deposit destination, billing method, tax profile ────────
// Kept as separate 1:1/1:many models (not flat Store columns) so sensitive
// fields (account number, taxpayer ID) can be encrypted at rest independently
// and so a store can hold >1 billing card, matching Etsy's own data shape.

model StoreBankAccount {
  id                     String          @id @default(dbgenerated("nanoid(12)"))
  storeId                String          @unique
  store                  Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  accountHolderName      String
  bankName               String
  accountNumberEncrypted String // full number, AES-256-GCM via EncryptionService
  accountNumberLast4     String // denormalized for display — never decrypt just to show "···· 0085"
  country                String          @db.VarChar(2)
  depositSchedule        DepositSchedule @default(WEEKLY)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model StoreBillingCard {
  id                    String   @id @default(dbgenerated("nanoid(12)"))
  storeId               String
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stripePaymentMethodId String   @unique
  fingerprint           String?
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int
  cardholderName        String
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([storeId])
  @@index([storeId, fingerprint])
}

model StoreTaxInfo {
  id                  String     @id @default(dbgenerated("nanoid(12)"))
  storeId             String     @unique
  store               Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sellerType          SellerType @default(INDIVIDUAL)
  fullLegalName       String
  taxpayerIdEncrypted String? // encrypted; nullable until the seller fills it in
  dateOfBirth         DateTime?
  country             String     @db.VarChar(2)
  streetAddress       String
  flatOther           String?
  city                String
  province            String?
  postCode            String?
  phone               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model StoreFollow {
  id        String   @id @default(dbgenerated("nanoid(12)"))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
}

model StoreOrder {
  id                       String      @id @default(dbgenerated("nanoid(12)"))
  orderId                  String
  order                    Order       @relation(fields: [orderId], references: [id])
  storeId                  String
  store                    Store       @relation(fields: [storeId], references: [id])
  status                   OrderStatus @default(PENDING_PAYMENT)
  subtotal                 Decimal     @db.Decimal(10, 2)
  discountAmount           Decimal     @default(0) @db.Decimal(10, 2)
  // Store/provider shipping quote. It is seller revenue only when paid by the
  // buyer; when shippingSubsidy covers it, it remains a platform expense.
  shippingCost             Decimal     @default(0) @db.Decimal(10, 2)
  // Portion of shippingCost funded by the platform rather than the buyer.
  shippingSubsidy          Decimal     @default(0) @db.Decimal(10, 2)
  platformFee              Decimal     @db.Decimal(10, 2)
  sellerEarnings           Decimal     @db.Decimal(10, 2)
  trackingNumber           String?
  trackingUrl              String?
  carrier                  String?
  shippedAt                DateTime?
  deliveredAt              DateTime?
  sellerNotes              String?
  // Only `Store.deliveryUpgradesEnabled` (a shop-level toggle) existed before —
  // this is the per-order flag so the Orders "Upgrade requested" filter is
  // real. No buyer-facing upgrade-selection UI exists yet at checkout, so
  // this stays false until that flow is built; the field/filter itself is
  // no longer decorative.
  deliveryUpgradeRequested Boolean     @default(false)

  /// Where the seller is up to in their own workflow. Nullable because a
  /// StoreOrder exists from the moment checkout starts, before it is paid for
  /// and before it belongs in anyone's queue; the pipeline begins at NEW once
  /// payment lands.
  progressStepId String?
  progressStep   OrderProgressStep? @relation(fields: [progressStepId], references: [id])

  /// The date the seller has promised to dispatch by. Seeded at checkout from
  /// the product's processing time and editable afterwards, because a promise
  /// that cannot be moved is one a seller will simply miss instead. Null means
  /// no estimate was ever set, which the Orders filters treat as its own case
  /// rather than folding into "overdue".
  shipByDate DateTime?

  payoutId      String?
  payout        SellerPayout?           @relation(fields: [payoutId], references: [id])
  items         OrderItem[]
  fulfillments  StoreOrderFulfillment[]
  ledgerEntries SellerLedgerEntry[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  // The buyer's `ezihubb_visitor` cookie at checkout time — lets Offsite Ads
  // cross-reference an external-referrer click logged on a DIFFERENT store's
  // page against a purchase made here ("indirect" ad traffic).
  visitorId String?

  @@unique([orderId, storeId])
  @@index([orderId])
  @@index([storeId])
  @@index([status])
  @@index([visitorId])
  @@index([storeId, shipByDate])
  @@index([progressStepId])
}

/// A step in one shop's own order workflow.
///
/// Five locked milestones mirror the buyer's public timeline. Sellers add,
/// rename, reorder and delete CUSTOM detail inside the production phase; each
/// custom step maps to the public IN_PRODUCTION status.
model OrderProgressStep {
  id      String                @id @default(dbgenerated("nanoid(12)"))
  storeId String
  store   Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    String                @db.VarChar(60)
  kind    OrderProgressStepKind @default(CUSTOM)

  /// Position in the pipeline. Deliberately NOT unique per store: the editor
  /// saves the whole list at once, and renumbering rows inside one
  /// transaction collides on any per-statement unique check.
  sortOrder Int

  storeOrders StoreOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, sortOrder])
}

enum OrderProgressStepKind {
  /// Locked public milestones, in fulfilment order.
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  COMPLETED
  /// Seller-defined production detail. Always public as IN_PRODUCTION.
  CUSTOM
}

model SellerPayout {
  id            String              @id @default(dbgenerated("nanoid(12)"))
  storeId       String
  store         Store               @relation(fields: [storeId], references: [id])
  period        String
  amount        Decimal             @db.Decimal(10, 2)
  platformFee   Decimal             @db.Decimal(10, 2)
  orderCount    Int                 @default(0)
  status        SellerPayoutStatus  @default(PENDING)
  paidAt        DateTime?
  processedById String?
  paymentMethod String?
  paymentDetail String?
  adminNotes    String?
  storeOrders   StoreOrder[]
  ledgerEntries SellerLedgerEntry[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([period])
}

model SellerLedgerEntry {
  id           String                @id @default(dbgenerated("nanoid(12)"))
  storeId      String
  store        Store                 @relation(fields: [storeId], references: [id])
  storeOrderId String?
  storeOrder   StoreOrder?           @relation(fields: [storeOrderId], references: [id])
  type         SellerLedgerEntryType
  // Signed: positive for SALE, negative for every fee type (TRANSACTION_FEE,
  // PAYMENT_PROCESSING_FEE, REGULATORY_FEE, LISTING_FEE). Summing a store's
  // unpaid (payoutId: null) rows gives the exact amount owed on next payout —
  // this table is the source of truth for payout batching, mirroring Etsy's
  // itemized "Payment account" statement.
  amount       Decimal               @db.Decimal(10, 2)
  description  String
  // Which product this entry relates to, for LISTING_FEE and its VAT line.
  // Nullable because most entry types (SALE, TRANSACTION_FEE, payouts) are
  // order-scoped, not product-scoped — those keep using storeOrderId.
  // Exists so the duplicate-charge guard can ask "has this product already
  // been charged a listing fee?" without LIKE-matching the description text.
  productId    String?
  payoutId     String?
  payout       SellerPayout?         @relation(fields: [payoutId], references: [id])
  createdAt    DateTime              @default(now())

  @@index([storeId, payoutId])
  @@index([storeId, productId, type])
}

// ── Marketing: Share & Save / Offsite Ads attribution (Etsy parity) ──────────
// One shared click/attribution model for both mechanisms — they're mutually
// exclusive per order (last click across BOTH kinds wins), so a single table
// discriminated by `kind` lets that resolution be a single query rather than
// two independent, possibly-conflicting checks.
model StoreLinkClick {
  id          String        @id @default(dbgenerated("nanoid(12)"))
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind        LinkClickKind
  visitorId   String // cookie-based visitor id of whoever CLICKED, same mechanism as affiliate tracking
  // Etsy Share & Save rewards the person who SHARED the link, not necessarily
  // the one who clicks it — set only for a SHARE_SAVE click carrying a
  // personalized `?ss=<userId>` link (see the buyer-facing share widget). A
  // generic, non-personalized link (or missing sharerId) earns no reward —
  // this is also what stops anyone self-serving a discount by hand-appending
  // `?ss=1`-style params with no real referrer identity.
  sharerId    String?
  productId   String? // null = shop-wide link click, not scoped to one listing
  // Referrer host for an OFFSITE_AD click (google.com, facebook.com, …); null
  // for a SHARE_SAVE click, which has no "channel" concept.
  source      String?
  convertedAt DateTime?
  orderId     String?
  createdAt   DateTime      @default(now())

  @@index([storeId, kind, createdAt])
  @@index([visitorId, createdAt])
}

// ── Marketing: automated targeted offers (Etsy "Set up targeted offers") ─────
// One row per store per trigger — firing creates a personalized single-use
// Promotion (Promotion.targetUserId set, maxUsesPerUser: 1, short expiresAt).
model TargetedOfferCampaign {
  id               String               @id @default(dbgenerated("nanoid(12)"))
  storeId          String
  store            Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  trigger          TargetedOfferTrigger
  discountType     DiscountType
  discountValue    Decimal              @db.Decimal(10, 2)
  // How long the personalized code stays valid once issued.
  expiresAfterDays Int                  @default(3)
  // Used by ABANDONED_BASKET/INTERESTED_SHOPPER — how far back to look for the
  // qualifying signal (e.g. cart untouched, or repeat views with no purchase).
  lookbackDays     Int                  @default(7)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([storeId, trigger])
  @@index([isActive])
}

// ── Marketing: Social media (Etsy parity, UI-only per explicit scope decision
// — no real OAuth/posting integration; StoreSocialConnection exists only so
// the "Social account settings" toggle UI has somewhere real to persist state,
// and SocialPost is the seller's own post-history record, not a real publish). ──
model StoreSocialConnection {
  id          String                 @id @default(dbgenerated("nanoid(12)"))
  storeId     String
  store       Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  status      SocialConnectionStatus @default(DISCONNECTED)
  connectedAt DateTime?

  @@unique([storeId, platform])
}

model SocialPost {
  id        String           @id @default(dbgenerated("nanoid(12)"))
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  content   String           @db.Text
  imageUrl  String?
  platforms SocialPlatform[]
  createdAt DateTime         @default(now())

  @@index([storeId, createdAt])
}

model PlatformSettings {
  id                        String   @id @default("singleton")
  // ── Seller fees (modeled on Etsy's published fee schedule) ────────────────
  transactionFeeRate        Decimal  @default(0.065) @db.Decimal(5, 4) // 6.5% of subtotal + shipping
  paymentProcessingFeeRate  Decimal  @default(0.05) @db.Decimal(5, 4) // 5% of subtotal + shipping
  paymentProcessingFixedFee Decimal  @default(0.25) @db.Decimal(10, 2)
  listingFee                Decimal  @default(0.20) @db.Decimal(10, 2) // charged once per product created
  regulatoryFeeRate         Decimal  @default(0.0124) @db.Decimal(5, 4)
  regulatoryFeeCountries    String[] @default([]) // ISO 3166-1 alpha-2 codes; empty = applies to nobody
  // VAT charged on top of the seller's other platform fees (Etsy: "VAT on
  // seller fees") — applied unconditionally, unlike regulatoryFee which is
  // country-gated. Default matches Vietnam's standard VAT rate.
  vatOnFeesRate             Decimal  @default(0.10) @db.Decimal(5, 4)
  // Etsy "Offsite Ads" — debited from the seller on an attributed order from
  // an external-referrer click (see StoreLinkClick), configurable like the
  // other seller fees rather than hardcoded.
  offsiteAdsFeeRate         Decimal  @default(0.15) @db.Decimal(5, 4)
  platformName              String   @default("EziHubb")
  allowPublicRegistration   Boolean  @default(false)
  minPayoutAmount           Decimal  @default(100.00) @db.Decimal(10, 2)
  payoutSchedule            String   @default("monthly")
  maintenanceMode           Boolean  @default(false)
  // Platform-funded free standard shipping. Zero disables the policy.
  // Eligibility uses merchandise subtotal after automatic sale prices, but
  // before coupons, bundles, shipping, and gift wrapping.
  freeShippingThreshold     Decimal  @default(100.00) @db.Decimal(10, 2)
  // ── Ezihubb Plus pricing (list price — see StoreSubscription.priceAtPurchase
  // for what an individual store actually locked in) ────────────────────────
  plusMonthlyPrice          Decimal  @default(5.00) @db.Decimal(10, 2)
  plusAnnualPrice           Decimal? @db.Decimal(10, 2) // NULL until confirmed — granting ANNUAL is rejected while null
  updatedAt                 DateTime @updatedAt
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String        @id @default(dbgenerated("nanoid(12)"))
  name        String
  slug        String        @unique
  description String?
  imageUrl    String?
  // 1 = nav tab (L1), 2 = group (L2), 3 = product category (L3)
  level       Int           @default(1)
  parentId    String?
  parent      Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]    @relation("CategoryTree")
  sortOrder   Int           @default(0)
  isVisible   Boolean       @default(true)
  scope       CategoryScope @default(PLATFORM)
  storeId     String?
  store       Store?        @relation(fields: [storeId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products          Product[]
  productCategories ProductCategory[]

  @@index([parentId])
  @@index([slug])
  @@index([level, isVisible])
  @@index([storeId])
}

// ── Multi-category membership ─────────────────────────────────────────────────

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model Collection {
  id          String    @id @default(dbgenerated("nanoid(12)"))
  name        String
  slug        String    @unique
  description String?
  bannerUrl   String?
  occasion    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  products CollectionProduct[]

  @@index([slug])
  @@index([isActive])
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model Tag {
  id   String @id @default(dbgenerated("nanoid(12)"))
  name String @unique
  slug String @unique

  products ProductTag[]
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  // New rows use a 12-character alphanumeric NanoID. The API also generates
  // Product IDs explicitly because product creation spans PostgreSQL and
  // MongoDB; this database default protects any other insertion path.
  // Existing CUID and 10-character NanoID rows remain valid.
  id                    String                   @id @default(dbgenerated("nanoid(12)"))
  name                  String
  slug                  String
  sku                   String                   @unique
  description           String
  shortDescription      String?
  // Postgres-generated (STORED, auto-maintained on every insert/update — see
  // migration 20260813140000). Prisma can't model tsvector natively; marking
  // it Unsupported keeps it visible in introspection without Prisma Client
  // trying to read/write it — search.service.ts touches it only via raw SQL.
  searchVector          Unsupported("tsvector")? @map("search_vector")
  basePrice             Decimal                  @db.Decimal(10, 2)
  compareAtPrice        Decimal?                 @db.Decimal(10, 2)
  isPersonalizable      Boolean                  @default(true)
  isActive              Boolean                  @default(true)
  status                ProductStatus            @default(ACTIVE)
  productType           ProductType              @default(PHYSICAL)
  /// Whether the seller offers gift wrapping for this listing. Distinct from
  /// Order.giftWrapping, which records what a buyer chose at checkout — this
  /// is whether the option can be offered at all.
  giftWrappingAvailable Boolean                  @default(false)
  isFeatured            Boolean                  @default(false)
  viewCount             Int                      @default(0)
  soldCount             Int                      @default(0)
  processingDays        Int                      @default(3)
  categoryId            String
  category              Category                 @relation(fields: [categoryId], references: [id])
  customizationConfig   Json?
  deletedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  moderationStatus ModerationStatus @default(PENDING)
  lastModeratedAt  DateTime?

  // ── Store ownership ─────────────────────────────────────────────────────────
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  // ── TAB: Item Details ───────────────────────────────────────────────────────
  titleCharCount Int? // cached char count for 140-char limit validation

  // ── TAB: Item Attributes (structured, searchable like Etsy) ────────────────
  primaryColors   String[] // multi-select colour tags
  secondaryColors String[]
  materials       String[] // up to 5 materials
  occasions       String[] // up to 13 occasions
  holidayTags     String[]
  recipientTags   String[] // up to 4 recipients
  styles          String[]
  sustainability  String[] // up to 3 sustainability attributes
  width           Decimal?       @db.Decimal(8, 2) // physical dimensions, buyer-facing info — not shipping-package dimensions
  height          Decimal?       @db.Decimal(8, 2)
  dimensionUnit   DimensionUnit?

  // ── TAB: Pricing & Inventory ────────────────────────────────────────────────
  domesticGlobalPricing Boolean      @default(false)
  quantity              Int? // null = unlimited (POD)
  trackInventory        Boolean      @default(false)
  lowStockThreshold     Int?
  returnPolicy          ReturnPolicy @default(NO_RETURNS)

  // ── TAB: Processing & Shipping Profiles ─────────────────────────────────────
  processingProfileId String?
  processingProfile   ProcessingProfile? @relation(fields: [processingProfileId], references: [id])
  shippingProfileId   String?
  shippingProfile     ShippingProfile?   @relation(fields: [shippingProfileId], references: [id])

  // ── TAB: How It's Made ──────────────────────────────────────────────────────
  whoMadeIt            WhoMadeIt?
  howItWasMade         HowItWasMade?
  /// Optional, like the two above it — an unanswered question stays
  /// unanswered rather than being defaulted into a claim the seller never made.
  whenMade             WhenMade?
  toolsUsed            String[] // "handheld" | "computerized" | "3d-printing" | "none"
  productionPartnerIds String[] // ID references to ProductionPartner records
  hsCode               String? // Harmonised System tariff code for customs
  featuredRelatedIds   String[] // up to 4 manually pinned related product IDs

  // ── TAB: Settings ───────────────────────────────────────────────────────────
  shopSectionId String?
  shopSection   ShopSection? @relation(fields: [shopSectionId], references: [id])
  isAdsEnabled  Boolean      @default(false)
  renewalType   RenewalType  @default(AUTOMATIC)
  expiresAt     DateTime? // only relevant when renewalType = MANUAL

  // ── TAB: Photo & Video ──────────────────────────────────────────────────────
  /// DEPRECATED — superseded by the `videos` relation, which carries the
  /// poster frames and duration this bare array cannot. Still written and
  /// still returned by the API so existing partner integrations reading
  /// `videoUrls` keep working; it is derived from `videos` on the way out.
  /// Remove only after partners have been given notice.
  videoUrls         String[]
  thumbnailCropData Json? // { x, y, width, height } for thumbnail crop

  // ── Relations ───────────────────────────────────────────────────────────────
  variants            ProductVariant[]
  images              ProductImage[]
  videos              ProductVideo[]
  collections         CollectionProduct[]
  tags                ProductTag[]
  wishlistItems       WishlistItem[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  messageAttachments  Message[]                   @relation("MessageAttachedProduct")
  customizationDrafts CustomizationDraft[]
  reviews             Review[]
  questions           ProductQuestion[]
  productCategories   ProductCategory[]
  variationGroups     VariationGroup[]
  variationSettings   VariationSettings?
  promotionProducts   PromotionProduct[]
  bundleOfferProducts BundleOfferProduct[]
  fulfillmentMappings ProductFulfillmentMapping[]
  digitalFiles        DigitalFile[]
  storeOfferListings  StoreOfferListing[]
  buyerOffers         BuyerOffer[]

  @@unique([slug, storeId])
  @@index([categoryId])
  @@index([storeId])
  @@index([isActive, isFeatured])
  @@index([isActive, soldCount])
  @@index([processingProfileId])
  @@index([shippingProfileId])
  @@index([shopSectionId])
}

model ProductVariant {
  id                String   @id @default(dbgenerated("nanoid(12)"))
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  options           Json
  // Nullable — a newly-generated combination (from Manage Variations, when
  // "Prices vary" is on) starts blank until the seller fills it in, matching
  // Etsy's own per-combination price grid. Publish is blocked while any
  // isAvailable row still has a null price (see ProductsService).
  price             Decimal? @db.Decimal(10, 2)
  // Per-combination quantity — only meaningful when VariationSettings.variesBy
  // includes 'quantity'; otherwise Product.quantity applies to every combo.
  quantity          Int?
  sku               String?  @unique
  // The "Visible" toggle per combination row in the price grid, and also how
  // syncVariantsFromGroups() retires a combination that no longer matches the
  // seller's options — never hard-deleted (ProductFulfillmentMapping cascades
  // on delete, and CartItem/OrderItem/DigitalFile would silently lose their
  // variant link), just hidden from new selection.
  isAvailable       Boolean  @default(true)
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  lowStockThreshold Int?

  cartItems           CartItem[]
  orderItems          OrderItem[]
  customizationDrafts CustomizationDraft[]
  fulfillmentMappings ProductFulfillmentMapping[]
  digitalFiles        DigitalFile[]

  @@index([productId])
}

// MOCKUP = a normal catalog/display photo, shown to shoppers.
// PRINT_FILE = an isolated, background-removed design asset for one print
// area — never shown to shoppers, only used when pushing a fulfillment
// order to a POD provider (see FulfillmentLineItem.printFiles).
enum ProductImageType {
  MOCKUP
  PRINT_FILE
}

enum PrintSide {
  FRONT
  BACK
  SLEEVE
  HOOD
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

/// Third leg of the listing-provenance trio, alongside WhoMadeIt and
/// HowItWasMade. Answers "when was it made", which is the only one of the
/// three that separates vintage from everything else.
///
/// Deliberately NOT a parallel "listing type" enum. HANDMADE and
/// MADE_TO_ORDER already live in HowItWasMade; repeating them here would let
/// one listing claim to be two different things with nothing to reconcile
/// them.
///
/// Two values, not a decade scale: the only question the search filter has to
/// answer is vintage or not, and a finer scale would be data sellers have to
/// enter and nobody would filter on.
enum WhenMade {
  /// Within roughly the last twenty years.
  RECENTLY_MADE
  /// Twenty years old or more.
  VINTAGE
}

model ProductImage {
  id        String           @id @default(dbgenerated("nanoid(12)"))
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  type      ProductImageType @default(MOCKUP)
  printSide PrintSide?

  @@index([productId])
  @@index([productId, type, printSide])
}

/// One uploaded product video plus the metadata derived from it at upload time.
///
/// Poster frames are REAL STORED FILES here, not URL transformations. Media
/// CDNs that derive every size from one asset on request make a thumbnail list
/// almost free; our storage is plain R2/S3 behind a static CDN with no
/// transform layer, so each variant is a separate object that upload has to
/// produce and delete has to clean up.
///
/// `durationSeconds` is stored as a number, not as an ISO 8601 string, so it
/// stays comparable — "clips under 5s" is a query, not a string scan. The
/// ISO 8601 form (PT10S) is produced at the response boundary.
///
/// Both the duration and the poster columns are NULLABLE on purpose: rows
/// backfilled from the old `Product.videoUrls` array have no poster frame and
/// no known duration, and inventing a 0 there would be a lie that renders as
/// a real value. Null means "never measured" and the API surfaces it as null.
model ProductVideo {
  id              String   @id @default(dbgenerated("nanoid(12)"))
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url             String
  /// Full-size poster frame, original aspect ratio — for the gallery.
  posterUrl       String?
  /// Square centre-cropped poster — for grid cards, where shipping the
  /// full-size frame would waste bandwidth on the densest screen we have.
  posterSquareUrl String?
  durationSeconds Float?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([productId])
}

// A digital product's deliverable file (design file, PNG/SVG/PDF/etc — never
// a physical item). storageKey is never surfaced in any API response; the raw
// object is fetched server-side only, by the download endpoint, and stamped
// per-buyer before streaming — see order-downloads.controller.ts.
model DigitalFile {
  id         String          @id @default(dbgenerated("nanoid(12)"))
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String? // null = applies to all variants
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  filename   String
  storageKey String
  mimeType   String
  sizeBytes  Int
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([productId])
}

// ─── Variation System (ETY-01) ────────────────────────────────────────────────
// Represents the admin-configurable variation structure for a product.
// VariationGroup = a dimension (e.g. "Color", "Size")
// VariationOption = a value within that dimension (e.g. "Red", "Small")
// VariationSettings = product-level toggle + metadata

model VariationGroup {
  id          String  @id @default(dbgenerated("nanoid(12)"))
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String // "Color", "Size", "Material"
  displayType String  @default("dropdown") // "dropdown" | "color_swatch" | "button" | "image"
  sortOrder   Int     @default(0)

  options VariationOption[]

  @@index([productId])
}

model VariationOption {
  id          String         @id @default(dbgenerated("nanoid(12)"))
  groupId     String
  group       VariationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String // "Red", "Small"
  value       String // slug / code, e.g. "red", "s"
  colorHex    String? // for color_swatch display type
  imageUrl    String? // for image display type (custom external URL)
  // Which product photo represents this variant option.
  // Intentionally no FK → ProductImage so image deletion doesn't cascade.
  imageId     String? // references ProductImage.id (soft reference)
  priceDelta  Decimal?       @db.Decimal(10, 2) // price adjustment from base
  sortOrder   Int            @default(0)
  isAvailable Boolean        @default(true)

  @@index([groupId])
}

model VariationSettings {
  id               String   @id @default(dbgenerated("nanoid(12)"))
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  enableVariations Boolean  @default(false)
  variesBy         String[] // names of active VariationGroup dimensions
  skuPrefix        String? // e.g. "MLH-MUG" → variants become "MLH-MUG-RED-M"
  // Which VariationGroup's options carry linked photos — at most one per
  // product, so a shopper picking "Black" can never be shown two competing
  // photos. A single pointer rather than a flag on each group: it makes "two
  // groups linked at once" unrepresentable instead of an invariant some
  // future code path has to remember to enforce.
  //
  // Turning photo linking off just clears this. The per-option
  // VariationOption.imageId values are deliberately left alone, so switching
  // it back on restores exactly what the seller had picked before — nothing
  // here ever deletes their work.
  //
  // Soft reference, no FK, for the same reason VariationOption.imageId has
  // none — and one more: applyVariations() deletes every group and recreates
  // it with the same id inside one transaction, so an onDelete: SetNull would
  // wipe this pointer on every Apply. applyVariations() nulls it explicitly
  // instead, and only when the group is really gone.
  photoGroupId     String?
}

// ─── Processing Profiles ──────────────────────────────────────────────────────
// Admin-defined production windows that can be assigned to products.

model ProcessingProfile {
  id        String                @id @default(dbgenerated("nanoid(12)"))
  name      String // "Made to order", "Ready to ship"
  type      ProcessingProfileType @default(MADE_TO_ORDER)
  minDays   Int                   @default(3)
  maxDays   Int                   @default(7)
  isDefault Boolean               @default(false)
  // Nullable for the handful of legacy platform-default profiles seeded
  // before per-store profiles existed (storeId: null, isDefault: true) —
  // every seller-created profile from here on always carries a storeId.
  storeId   String?
  store     Store?                @relation(fields: [storeId], references: [id])
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  products Product[]

  @@index([storeId])
}

// ─── Shipping Profiles ────────────────────────────────────────────────────────
// Seller-owned "Delivery profiles" (Etsy: Shop Manager → Settings → Delivery
// settings → Delivery profiles) — the sole source of shipping cost/timeline
// at checkout (see ShippingService.resolveSellerShippingCost()).

model ShippingProfile {
  id               String   @id @default(dbgenerated("nanoid(12)"))
  name             String // "Standard Shipping", "Embroidered Hat"
  activeListings   Int      @default(0) // denormalised count
  isDefault        Boolean  @default(false)
  originCountry    String   @default("VN") @db.VarChar(2) // ISO 3166-1 alpha-2
  originPostalCode String   @default("")
  storeId          String?
  store            Store?   @relation(fields: [storeId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  methods  ShippingProfileMethod[]
  products Product[]

  @@index([storeId])
}

model ShippingProfileMethod {
  id              String             @id @default(dbgenerated("nanoid(12)"))
  profileId       String
  profile         ShippingProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  destinationType String // "domestic" | "everywhere_else" | ISO country code
  // Named service from the platform's fixed carrier list (GHN, GHTK, DHL...)
  // or "OTHER" — when OTHER, carrierName holds the seller's free-text label
  // and minDays/maxDays become seller-entered instead of a known SLA.
  carrierService  String             @default("OTHER")
  carrierName     String? // free-text label, only meaningful when carrierService = "OTHER"
  chargeType      ShippingChargeType @default(FIXED)
  minDays         Int
  maxDays         Int
  // Null when chargeType = FREE — the row still carries a destination and
  // delivery-time SLA, just no cost.
  price           Decimal?           @db.Decimal(10, 2)
  extraItemPrice  Decimal?           @db.Decimal(10, 2) // additional item surcharge, FIXED only

  @@index([profileId])
}

// ─── Shop Sections ────────────────────────────────────────────────────────────
// Organise listings into labelled sections visible on the shop front.

model ShopSection {
  id        String   @id @default(dbgenerated("nanoid(12)"))
  name      String
  sortOrder Int      @default(0)
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  createdAt DateTime @default(now())

  products Product[]

  @@index([storeId])
}

// ─── Production Partners ──────────────────────────────────────────────────────
// Third-party manufacturers or fulfilment partners disclosed on listings.

model ProductionPartner {
  id          String   @id @default(dbgenerated("nanoid(12)"))
  name        String
  description String?
  location    String? // "Country" or "City, Country"
  createdAt   DateTime @default(now())
}

// ─── Personalization ─────────────────────────────────────────────────────────

model CustomizationDraft {
  id             String          @id @default(dbgenerated("nanoid(12)"))
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId      String?
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  templateId     String
  data           Json
  previewUrl     String?
  uploadedImages Json?
  createdAt      DateTime        @default(now())
  expiresAt      DateTime?

  @@index([userId, productId])
  @@index([sessionId])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id             String    @id @default(dbgenerated("nanoid(12)"))
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String?   @unique
  couponCode     String?
  discountAmount Decimal?  @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?

  items                CartItem[]
  abandonedEmailSentAt DateTime?
}

model CartItem {
  id                String          @id @default(dbgenerated("nanoid(12)"))
  cartId            String
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity          Int             @default(1)
  unitPrice         Decimal         @db.Decimal(10, 2)
  customizationData Json?
  previewUrl        String?
  // Search term that led the buyer to this product (via ?st= on the product
  // link), if any — carried over to OrderItem at checkout so purchases can be
  // attributed back to the keyword for marketplace-insights conversion rates.
  searchTerm        String?
  createdAt         DateTime        @default(now())

  storeId String?
  store   Store?  @relation("CartItemStore", fields: [storeId], references: [id])

  @@index([cartId])
  @@index([productId])
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(dbgenerated("nanoid(12)"))
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation("UserOrders", fields: [userId], references: [id], onDelete: SetNull)
  guestEmail      String?
  status          OrderStatus @default(PENDING_PAYMENT)
  isDigital       Boolean     @default(false)
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?     @default("US")
  shippingMethod  String?
  // Shipping charged to the buyer after platform support/coupons.
  shippingCost    Decimal     @db.Decimal(10, 2)
  // Shipping funded by the platform. This is deliberately separate from
  // shippingCost so seller revenue is not reduced when the threshold applies.
  shippingSubsidy Decimal     @default(0) @db.Decimal(10, 2)
  subtotal        Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  couponCode      String?
  trackingNumber  String?
  trackingUrl     String?
  carrier         String?
  trackerId       String?

  // ── Gift options ──────────────────────────────────────────────────────────
  isGift       Boolean @default(false)
  giftMessage  String? @db.VarChar(500)
  giftReceipt  Boolean @default(false)
  giftWrapping Boolean @default(false)
  giftFrom     String? @db.VarChar(100)

  note         String?
  privateNote  String?
  cancelReason String?
  cancelledAt  DateTime?
  confirmedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items           OrderItem[]
  storeOrders     StoreOrder[]
  statusHistory   OrderStatusHistory[]
  payment         Payment?
  promotionUsages PromotionUsage[]
  giftCardUsages  GiftCardUsage[]
  conversations   Conversation[]

  // Affiliate attribution (null if not a referred order)
  affiliateId             String?
  affiliate               AffiliateAccount?    @relation(fields: [affiliateId], references: [id])
  affiliateDiscountAmount Decimal?             @db.Decimal(10, 2)
  commission              AffiliateCommission?

  // Label purchase (EasyPost)
  easypostShipmentId String?
  labelUrl           String?
  labelPurchasedAt   DateTime?
  labelCost          Decimal?       @db.Decimal(10, 2)
  shippingRateId     String?
  tracking           OrderTracking?

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([affiliateId])
}

model OrderItem {
  id                String          @id @default(dbgenerated("nanoid(12)"))
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  customizationData Json?
  previewUrl        String?
  // Carried over from CartItem.searchTerm — see comment there.
  searchTerm        String?
  createdAt         DateTime        @default(now())

  // ── Snapshots (captured at order time, never changes) ──────────────────────
  productName     String
  variantName     String?
  productSlug     String?
  productImageUrl String?
  variantSnapshot Json?
  sku             String?

  // ── Store attribution ──────────────────────────────────────────────────────
  storeId      String?
  storeOrderId String?
  storeOrder   StoreOrder? @relation(fields: [storeOrderId], references: [id])

  digitalDownloadLogs DigitalDownloadLog[]

  @@index([orderId])
  @@index([productId])
  @@index([storeOrderId])
  @@index([storeId])
}

// One row per digital-file download attempt — the audit trail backing
// per-buyer traceability (see DigitalFile / order-downloads.controller.ts).
model DigitalDownloadLog {
  id           String    @id @default(dbgenerated("nanoid(12)"))
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  fileId       String
  ip           String?
  userAgent    String?
  downloadedAt DateTime  @default(now())

  @@index([orderItemId])
}

model OrderStatusHistory {
  id        String      @id @default(dbgenerated("nanoid(12)"))
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ─── Payment ─────────────────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(dbgenerated("nanoid(12)"))
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id])
  method                PaymentMethod
  status                PaymentStatus @default(PENDING)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  paypalOrderId         String?       @unique
  paypalCaptureId       String?
  giftCardCode          String?
  giftCardAmount        Decimal?      @db.Decimal(10, 2)
  refundedAmount        Decimal       @default(0) @db.Decimal(10, 2)
  refundedAt            DateTime?
  refundReason          String?
  paidAt                DateTime?
  providerEventId       String?       @unique
  createdAt             DateTime      @default(now())
}

model GiftCard {
  id           String    @id @default(dbgenerated("nanoid(12)"))
  code         String    @unique
  initialValue Decimal   @db.Decimal(10, 2)
  balance      Decimal   @db.Decimal(10, 2)
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  // Purchase metadata (set when a customer buys a gift card via Stripe)
  recipientEmail        String?
  recipientName         String?
  personalMessage       String? @db.Text
  purchasedByUserId     String?
  stripePaymentIntentId String? @unique

  usages GiftCardUsage[]
}

model GiftCardUsage {
  id         String   @id @default(dbgenerated("nanoid(12)"))
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  usedAt     DateTime @default(now())

  @@index([giftCardId])
  @@index([orderId])
}

// ─── Promotion ───────────────────────────────────────────────────────────────

model Promotion {
  id             String       @id @default(dbgenerated("nanoid(12)"))
  /**
   * Null only for an autoApply sale (no buyer-entered code) — every coupon-code promotion keeps a required, unique code.
   */
  code           String?      @unique
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxUses        Int?
  maxUsesPerUser Int          @default(1)
  currentUses    Int          @default(0)
  isActive       Boolean      @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  description    String?
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id])
  createdAt      DateTime     @default(now())

  /**
   * Etsy "Set up a sale" — silently applied at the best-price calculation, no buyer code entry. False = today's coupon-code behavior.
   */
  autoApply          Boolean        @default(false)
  scope              PromotionScope @default(SHOP_WIDE)
  /**
   * Nullable = "Everywhere". ISO 3166-1 alpha-2, checked against the buyer's shipping country at checkout.
   */
  country            String?
  /**
   * Buyer-facing terms shown on eligible listings during the sale — distinct from `description`, which stays admin-only.
   */
  termsAndConditions String?
  /**
   * Set only for a personalized targeted-offer send (A4) — ties a single-use promo to the one buyer it was emailed to.
   */
  targetUserId       String?

  usages   PromotionUsage[]
  products PromotionProduct[]

  @@index([code])
  @@index([isActive])
  @@index([storeId])
  @@index([autoApply])
  @@index([targetUserId])
}

model PromotionProduct {
  id          String    @id @default(dbgenerated("nanoid(12)"))
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([productId])
}

model PromotionUsage {
  id          String    @id @default(dbgenerated("nanoid(12)"))
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  userId      String?
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  usedAt      DateTime  @default(now())

  @@index([promotionId])
  @@index([userId])
  @@index([orderId])
}

// ─── Bundle offer ("Buy them together") ───────────────────────────────────────

model BundleOffer {
  id              String   @id @default(dbgenerated("nanoid(12)"))
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  discountPercent Decimal  @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  products BundleOfferProduct[]

  @@index([storeId])
  @@index([isActive])
}

model BundleOfferProduct {
  id            String      @id @default(dbgenerated("nanoid(12)"))
  bundleOfferId String
  bundleOffer   BundleOffer @relation(fields: [bundleOfferId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleOfferId, productId])
  @@index([productId])
}

// ── Marketing: Let buyers make offers (Etsy parity) ───────────────────────────

model StoreOfferListing {
  id        String  @id @default(dbgenerated("nanoid(12)"))
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId])
}

model BuyerOffer {
  id           String           @id @default(dbgenerated("nanoid(12)"))
  productId    String
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  offeredPrice Decimal          @db.Decimal(10, 2)
  /**
   * Set only when the seller counters instead of accepting/rejecting outright.
   */
  counterPrice Decimal?         @db.Decimal(10, 2)
  status       BuyerOfferStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([storeId, status])
  @@index([productId])
  @@index([buyerId])
}

// ─── Review ──────────────────────────────────────────────────────────────────

model Review {
  id              String       @id @default(dbgenerated("nanoid(12)"))
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId         String
  rating          Int
  title           String?
  body            String
  imageUrls       String[]
  status          ReviewStatus @default(PENDING)
  adminReply      String?
  repliedAt       DateTime?
  sellerReply     String?
  sellerRepliedAt DateTime?
  helpfulCount    Int          @default(0)
  storeId         String?
  store           Store?       @relation("StoreReviews", fields: [storeId], references: [id])
  createdAt       DateTime     @default(now())

  moderationStatus ModerationStatus @default(PENDING)

  @@unique([userId, productId, orderId])
  @@index([productId, status])
  @@index([userId])
  @@index([storeId])
}

// ─── Product Q&A ─────────────────────────────────────────────────────────────

model ProductQuestion {
  id        String  @id @default(dbgenerated("nanoid(12)"))
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  question     String  @db.VarChar(500)
  askedByName  String  @db.VarChar(100)
  askedByEmail String?
  isGuest      Boolean @default(true)

  answer      String?   @db.Text
  answeredAt  DateTime?
  isPublished Boolean   @default(false)

  isSpam  Boolean @default(false)
  upvotes Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isPublished])
  @@index([productId, createdAt])
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(dbgenerated("nanoid(12)"))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─── Attribute dictionary ─────────────────────────────────────────────────────
// Searchable attribute values per type.  Admin-seeded + extensible at runtime.

model AttributeValue {
  id    String @id @default(dbgenerated("nanoid(12)"))
  type  String // "color" | "material" | "occasion" | "holiday" | "recipient" | "style" | "sustainability"
  value String

  @@unique([type, value])
  @@index([type])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

enum ConversationStatus {
  OPEN // active, needs attention
  PENDING // waiting for customer reply
  RESOLVED // marked done by admin
  SPAM // marked as spam
  ARCHIVED // filed away, out of the inbox but not deleted
  TRASHED // in the bin, recoverable until purged
}

enum SenderType {
  CUSTOMER // message from buyer
  SHOP // message from shop/admin
  SYSTEM // automated message (order update, etc.)
}

model Conversation {
  id String @id @default(dbgenerated("nanoid(12)"))

  // A conversation belongs to either a specific order, or is general inquiry
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // The customer side
  userId     String? // null if guest
  user       User?   @relation(fields: [userId], references: [id])
  guestEmail String? // for guest conversations
  guestName  String?

  // Store context (which store this conversation is with)
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  // Metadata
  subject       String? // optional subject line
  status        ConversationStatus @default(OPEN)
  lastMessage   String? // preview of last message (denormalized)
  lastMessageAt DateTime?

  // Unread counts (denormalized for badge display)
  unreadByAdmin    Int @default(0)
  unreadByCustomer Int @default(0)

  /// Starring is a separate axis from status on purpose: a starred thread is
  /// still in the inbox, and folding it into `status` would make starring
  /// something that files the thread away.
  isStarred Boolean @default(false)

  /// Where ARCHIVED and TRASHED came from, so "move back to inbox" has a
  /// target. `status` is a single field, so filing a thread otherwise
  /// overwrites whether it had been resolved — and restoring it would have to
  /// guess. Null whenever `status` is not ARCHIVED or TRASHED.
  statusBeforeFiling ConversationStatus?

  /// Drives both the reply arrow on each row and the Sent folder. Denormalised
  /// rather than derived: the alternative is an EXISTS over every thread's
  /// messages on every inbox render.
  hasSellerReplied Boolean @default(false)

  /// When the BUYER removed this thread from their own list.
  ///
  /// Not a delete. The shop is the other party to the conversation and keeps
  /// its copy — the same reason unsending a message blanks it rather than
  /// erasing the row. Cleared when the shop writes again, so "delete" behaves
  /// the way every messenger behaves: it clears the list until there is
  /// something new to say.
  hiddenByCustomerAt DateTime?

  labels  ConversationLabelLink[]
  reports ConversationReport[]

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ONE conversation per (shop, buyer). Enforced by two PARTIAL unique
  /// indexes that Prisma cannot express and therefore does not know about:
  ///   Conversation_store_user_key   (storeId, userId)         WHERE both set
  ///   Conversation_store_guest_key  (storeId, lower(guestEmail)) WHERE guest
  /// They live in 20260825061330_one_conversation_per_buyer.
  ///
  /// "prisma migrate deploy" does not check drift, so this holds in production
  /// — but "prisma migrate dev" will offer to drop them as unknown objects,
  /// and accepting that would silently restore a thread per order.

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([storeId])
  // The inbox is always "this shop, newest first, in this folder".
  @@index([storeId, status, lastMessageAt])
  @@index([storeId, isStarred])
}

/// A label a shop invents for its own inbox.
///
/// Seller-defined rather than a fixed enum: what one shop files under
/// "Custom order" another calls "Commission", and neither is the platform's
/// business. Deliberately separate from the system-assigned chip on a thread
/// that came in as help with an order — that one is derived from the thread
/// having an order attached, and a seller must not be able to rename or
/// delete it out from under the folder that depends on it.
model ConversationLabel {
  id      String @id @default(dbgenerated("nanoid(12)"))
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    String @db.VarChar(40)

  /// Token name from the app palette, not a raw hex value — the inbox chips
  /// have to keep working when the theme changes.
  color String @default("muted")

  links ConversationLabelLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

model ConversationLabelLink {
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  labelId        String
  label          ConversationLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([conversationId, labelId])
  @@index([labelId])
}

/// A shop's private note about one buyer.
///
/// Attached to the buyer, not to a thread: a note like "prefers tracked
/// postage" is true of the person, and repeating it on every conversation
/// would mean updating it in several places or trusting the newest one.
/// Never shown to the buyer.
model BuyerNote {
  id      String @id @default(dbgenerated("nanoid(12)"))
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// The buyer's user id, or `guest:<email>` when there is no account. One
  /// column rather than two nullable ones, because a note has exactly one
  /// subject and a pair of partial unique indexes would not say so.
  buyerKey String

  body String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, buyerKey])
}

/// Temporary away-message for a shop.
///
/// Only the dated kind is modelled here. The reference also offers a weekly
/// schedule, but the screenshot never opens it, and inventing office-hours
/// semantics would bake a guess into the schema.
model StoreAutoReply {
  storeId String @id
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  message String @db.Text

  /// Null means off. A date rather than a boolean so the shop cannot leave
  /// itself silently auto-replying for months — it lapses on its own.
  activeUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A reusable message body the shop keeps to hand — the seller picks one
/// instead of retyping the same reply. Distinct from StoreAutoReply, which
/// sends itself: a snippet is only ever inserted deliberately, and is edited
/// in the composer before it goes anywhere.
model MessageSnippet {
  id      String @id @default(dbgenerated("nanoid(12)"))
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// What the seller picks it out of the list by.
  title String @db.VarChar(120)
  body  String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Two snippets with the same name are indistinguishable in the menu.
  @@unique([storeId, title])
  @@index([storeId])
}

model Message {
  id             String       @id @default(dbgenerated("nanoid(12)"))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Who sent it
  senderType SenderType
  senderId   String? // userId if customer, adminId if shop

  /// Chosen by the sender's browser before the request leaves, so a retry
  /// carries the same value as the attempt it is retrying.
  ///
  /// Without it a request that timed out mid-flight is indistinguishable from
  /// one that never arrived: the buyer presses send again and the thread gets
  /// the message twice. That needs no scale at all to happen — one person on a
  /// flaky connection is enough.
  ///
  /// Nullable, and unique only WITH conversationId: Postgres allows repeated
  /// NULLs in a unique index, so every message written before this existed,
  /// and any future path that does not supply one, still insert freely.
  clientMessageId String?

  body           String   @db.Text
  attachmentUrls String[] // up to 3 image attachments

  /// A listing shared inside the message, rendered as a card with its current
  /// price. Referenced live rather than snapshotted so the card cannot quote a
  /// price the shop no longer offers; SetNull because a delisted product must
  /// not take the conversation with it.
  attachedProductId String?
  attachedProduct   Product? @relation("MessageAttachedProduct", fields: [attachedProductId], references: [id], onDelete: SetNull)

  isRead Boolean   @default(false)
  readAt DateTime?

  /// When the shop withdrew this message.
  ///
  /// Soft, not a DELETE. The buyer may already have read it, so the honest
  /// thing to show them is that something was withdrawn rather than a gap
  /// where a message used to be — and a moderation report about a message
  /// that no longer exists is unanswerable.
  ///
  /// The body is left in place HERE: it is the evidence. The API stops
  /// sending it the moment this is set — see redactWithdrawn in
  /// messages.service.ts. Leaving that to the renderer was not enough; the
  /// text still travelled in the JSON.
  deletedAt DateTime?
  /// Which admin withdrew it. No FK — the same reason senderId has none, and
  /// an admin being removed must not erase the record of what they did.
  deletedBy String?

  createdAt DateTime @default(now())

  moderationStatus ModerationStatus @default(CLEAN)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([attachedProductId])
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("nanoid(12)"))
  userId     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Affiliate Program ────────────────────────────────────────────────────────

model AffiliateSettings {
  id                String   @id @default("singleton") // enforces 1 row
  defaultRate       Decimal  @default(0.10) @db.Decimal(5, 4) // 10%
  buyerDiscountRate Decimal  @default(0.05) @db.Decimal(5, 4) // 5%
  cookieDays        Int      @default(30)
  minPayoutAmount   Decimal  @default(50.00) @db.Decimal(10, 2)
  lockDays          Int      @default(14) // days after DELIVERED → CONFIRMED
  isEnabled         Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model AffiliateAccount {
  id String @id @default(dbgenerated("nanoid(12)"))

  // Identity — affiliate may or may not be a registered customer
  email            String  @unique
  firstName        String
  lastName         String
  website          String? // their blog/social URL
  promoDescription String? // how they plan to promote

  // Optional link to a User account (if affiliate is also a buyer)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Referral identity
  referralCode String  @unique // e.g. "SARAH2024"
  referralUrl  String? // computed: base_url?ref=CODE

  // Commission config
  commissionRate Decimal?        @db.Decimal(5, 4) // null = use global default
  status         AffiliateStatus @default(PENDING)

  // Financial summary (denormalized for dashboard speed)
  balance     Decimal @default(0) @db.Decimal(10, 2) // confirmed, unpaid
  totalEarned Decimal @default(0) @db.Decimal(10, 2) // all-time paid+confirmed

  // Admin notes
  adminNotes     String?
  rejectedReason String?
  approvedAt     DateTime?
  approvedById   String?

  clicks      AffiliateClick[]
  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralCode])
  @@index([status])
  @@index([email])
}

model AffiliateClick {
  id          String           @id @default(dbgenerated("nanoid(12)"))
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id])

  visitorId   String // random UUID stored in cookie
  ip          String?
  userAgent   String?
  landingPage String // full URL they landed on
  referrer    String? // where they came from

  convertedAt DateTime? // set when visitor places an order
  orderId     String? // FK if converted

  createdAt DateTime @default(now())

  @@index([affiliateId])
  @@index([visitorId])
  @@index([createdAt])
}

model AffiliateCommission {
  id          String           @id @default(dbgenerated("nanoid(12)"))
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id])

  orderId String @unique // one commission per order
  order   Order  @relation(fields: [orderId], references: [id])

  baseAmount Decimal          @db.Decimal(10, 2) // order subtotal used
  rate       Decimal          @db.Decimal(5, 4) // rate at time of order
  amount     Decimal          @db.Decimal(10, 2) // baseAmount × rate
  status     CommissionStatus @default(PENDING)

  confirmedAt  DateTime? // 14d after delivery
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

model AffiliatePayout {
  id          String           @id @default(dbgenerated("nanoid(12)"))
  affiliateId String
  affiliate   AffiliateAccount @relation(fields: [affiliateId], references: [id])

  amount Decimal      @db.Decimal(10, 2)
  status PayoutStatus @default(REQUESTED)

  // Payment details (affiliate fills in)
  paymentMethod String // "paypal", "bank_transfer", "store_credit"
  paymentDetail String // PayPal email / bank account / etc.

  // Admin
  adminNotes    String?
  processedAt   DateTime?
  processedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
}

// ─── Admin Settings ───────────────────────────────────────────────────────────

model AppSettings {
  id        String   @id @default(dbgenerated("nanoid(12)"))
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model EmailTemplateOverride {
  id        String   @id @default(dbgenerated("nanoid(12)"))
  slug      String   @unique
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── i18n Translations ────────────────────────────────────────────────────────
// Polymorphic translation table for DB-stored content (product names, category
// names, descriptions, etc.). English is the source language stored on the
// entity itself; translations live here.

model Translation {
  id               String   @id @default(dbgenerated("nanoid(12)"))
  entityType       String // "Product" | "Category" | "Collection" | "Tag" | "ShopSection"
  entityId         String
  locale           String // "vi" | "fr" | "zh" — never "en"
  field            String // "name" | "description" | "seoTitle" | "seoDescription"
  value            String   @db.Text
  isAutoTranslated Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, entityId, locale, field])
  @@index([entityType, entityId, locale])
  @@index([locale])
}

// ─── Moderation ───────────────────────────────────────────────────────────────

enum ModerationStatus {
  PENDING // just created, awaiting moderation
  CLEAN // passed moderation
  FLAGGED // auto-flagged, awaiting admin review
  REJECTED // admin confirmed violation, content hidden
  APPEALED // seller appealed, awaiting re-review
  APPROVED // admin overrode, restored despite flag
}

model ModerationLog {
  id String @id @default(dbgenerated("nanoid(12)"))

  entityType  String
  entityId    String
  fieldName   String?
  contentHash String

  verdict       ModerationStatus
  severity      String
  categories    String[]
  confidence    Float
  reasoning     String?          @db.Text
  sellerMessage String?          @db.Text

  provider     String   @default("claude")
  modelVersion String?
  latencyMs    Int?
  cost         Decimal? @db.Decimal(10, 6)

  triggeredBy String
  reviewedBy  String?
  reviewedAt  DateTime?
  adminNotes  String?   @db.Text

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([verdict])
  @@index([createdAt])
  @@index([contentHash])
}

model ModerationSettings {
  id String @id @default("singleton")

  isEnabled Boolean @default(true)

  moderateProductText Boolean @default(true)
  moderateStoreText   Boolean @default(true)
  moderateReviews     Boolean @default(true)
  moderateMessages    Boolean @default(true)
  moderateImages      Boolean @default(true)

  autoCriticalBlock Boolean @default(true)
  autoHighFlag      Boolean @default(true)
  autoMediumFlag    Boolean @default(true)
  autoLowWarn       Boolean @default(true)

  cacheCleanResultDays Int @default(30)

  strikeEnabled       Boolean @default(true)
  strikeLimitHigh     Int     @default(3)
  strikeLimitCritical Int     @default(1)
  strikeWindowDays    Int     @default(30)

  // 500, not 10000: at roughly $0.01 an image check that old ceiling allowed
  // ~$100 a day to be spent before anything stopped it. 500 is well above
  // normal traffic and caps a runaway — a bulk import or an edit loop — at
  // around $6. Raise it deliberately in Moderation → Settings if a real
  // catalogue import needs the headroom.
  maxDailyApiCalls Int     @default(500)
  maxCostPerDayUsd Decimal @default(50.00) @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt
}

model ModerationRule {
  id          String   @id @default(dbgenerated("nanoid(12)"))
  name        String
  description String?
  ruleType    String
  value       String
  severity    String
  isActive    Boolean  @default(true)
  applyTo     String[]
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([ruleType, isActive])
}

model StrikeRecord {
  id        String   @id @default(dbgenerated("nanoid(12)"))
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  severity  String
  logId     String
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

